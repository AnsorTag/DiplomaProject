# Existing local PostgreSQL connection for Python/SQLAlchemy.
# Copy to .env only when local credentials need to be configured.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasks

# Existing local PostgreSQL connection for Java/JDBC.
DB_JDBC_URL=jdbc:postgresql://localhost:5432/tasks
DB_USER=postgres
DB_PASSWORD=postgres

# Optional Java executor bridge to Python task modules.
PYTHON_EXECUTABLE=../venv/bin/python
PYTHON_TASK_RUNNER=../python_tasks/run_task.py
